      - Action:\n                  - sqs:SendMessage\n                Effect: Allow\n                Resource:\n                  Fn::GetAtt:\n                    - ChatLambdaDLQ\n                    - Arn\n            Version: '2012-10-17'\n          PolicyName: InvokeAgentCore\n      RoleName: RestaurantAgent-ChatLambda-Role\n    Type: AWS::IAM::Role\n"}}}}],"properties":{"tags":["aws","cdk","cdk-nag","AwsSolutions","AwsSolutions-IAM5","ChatLambdaRole","AWS::IAM::Role","tool_name::cdk-nag","tool_type::IAC"],"cdk_nag_finding":{"rule_id":"AwsSolutions-IAM5","resource_id":"ASHCDKNagScanner/deployment--chat-endpoint.yaml/ChatLambdaRole","compliance":"Non-Compliant","exception_reason":"N/A","rule_level":"Error","rule_info":"The IAM entity contains wildcard permissions and does not have a cdk-nag rule suppression with evidence for those permission."},"cfn_resource":{"Resources":{"ChatLambdaRole":{"Type":"AWS::IAM::Role","Properties":{"RoleName":"RestaurantAgent-ChatLambda-Role","AssumeRolePolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"lambda.amazonaws.com"},"Action":"sts:AssumeRole"}]},"ManagedPolicyArns":["arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"],"Policies":[{"PolicyName":"InvokeAgentCore","PolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":["bedrock-agentcore:InvokeAgentRuntime","bedrock-agentcore:Invoke"],"Resource":"*"},{"Effect":"Allow","Action":["sqs:SendMessage"],"Resource":{"Fn::GetAtt":["ChatLambdaDLQ","Arn"]}}]}}]}}}}}},{"ruleId":"AwsSolutions-L1","kind":"fail","level":"error","message":{"text":"The non-container Lambda function is not configured to use the latest runtime version.\n\nException Reason: N/A"},"analysisTarget":{"uri":"deployment/chat-endpoint.yaml"},"locations":[{"id":1,"physicalLocation":{"artifactLocation":{"uri":"deployment/chat-endpoint.yaml"},"region":{"startLine":22,"startColumn":2,"endLine":22,"endColumn":12,"snippet":{"text":"Resources:\n  ChatLambda:\n    Properties:\n      Code:\n        ZipFile: \"import json\\nimport boto3\\nimport os\\n\\ndef handler(event, context):\\n    try:\\n        body = json.loads(event.get('body',\\\n          \\ '{}'))\\n        prompt = body.get('prompt', '')\\n        session_id = body.get('sessionId', f\\\"session-{context.aws_request_id}\\\"\\\n          )\\n        \\n        if not prompt:\\n            return {\\n                'statusCode': 400,\\n                'headers':\\\n          \\ cors_headers(),\\n                'body': json.dumps({'error': 'prompt required'})\\n            }\\n        \\n \\\n          \\       # Invoke AgentCore\\n        client = boto3.client('bedrock-agentcore')\\n        agent_arn = os.environ['AGENT_RUNTIME_ARN']\\n\\\n          \\        \\n        response = client.invoke_agent_runtime(\\n            agentRuntimeArn=agent_arn,\\n           \\\n          \\ payload=json.dumps({\\n                'prompt': prompt,\\n                'sessionId': session_id\\n           \\\n          \\ }).encode('utf-8')\\n        )\\n        \\n        # Read response\\n        response_body = response['response'].read().decode('utf-8')\\n\\\n          \\        result = json.loads(response_body)\\n        \\n        return {\\n            'statusCode': 200,\\n      \\\n          \\      'headers': cors_headers(),\\n            'body': json.dumps({\\n                'result': result.get('result',\\\n          \\ ''),\\n                'sessionId': session_id\\n            })\\n        }\\n    except Exception as e:\\n       \\\n          \\ print(f\\\"Error: {str(e)}\\\")\\n        return {\\n            'statusCode': 500,\\n            'headers': cors_headers(),\\n\\\n          \\            'body': json.dumps({'error': str(e)})\\n        }\\n\\ndef cors_headers():\\n    return {\\n        'Content-Type':\\\n          \\ 'application/json',\\n        'Access-Control-Allow-Origin': '*',\\n        'Access-Control-Allow-Headers': 'Content-Type',\\n\\\n          \\        'Access-Control-Allow-Methods': 'POST,OPTIONS'\\n    }\\n\"\n      DeadLetterConfig:\n        TargetArn:\n          Fn::GetAtt:\n            - ChatLambdaDLQ\n            - Arn\n      Environment:\n        Variables:\n          AGENT_RUNTIME_ARN:\n            Ref: AgentRuntimeArn\n      FunctionName: RestaurantAgent-Chat\n      Handler: index.handler\n      KmsKeyArn:\n        Fn::GetAtt:\n          - ChatLambdaEnvEncryptionKey\n          - Arn\n      MemorySize: 512\n      ReservedConcurrentExecutions: 10\n      Role:\n        Fn::GetAtt:\n          - ChatLambdaRole\n          - Arn\n      Runtime: python3.13\n      Timeout: 300\n    Type: AWS::Lambda::Function\n"}}}}],"properties":{"tags":["aws","cdk","cdk-nag","AwsSolutions","AwsSolutions-L1","ChatLambda","AWS::Lambda::Function","tool_name::cdk-nag","tool_type::IAC"],"cdk_nag_finding":{"rule_id":"AwsSolutions-L1","resource_id":"ASHCDKNagScanner/deployment--chat-endpoint.yaml/ChatLambda","compliance":"Non-Compliant","exception_reason":"N/A","rule_level":"Error","rule_info":"The non-container Lambda function is not configured to use the latest runtime version."},"cfn_resource":{"Resources":{"ChatLambda":{"Type":"AWS::Lambda::Function","Properties":{"FunctionName":"RestaurantAgent-Chat","Runtime":"python3.13","Handler":"index.handler","Role":{"Fn::GetAtt":["ChatLambdaRole","Arn"]},"Timeout":300,"MemorySize":512,"ReservedConcurrentExecutions":10,"KmsKeyArn":{"Fn::GetAtt":["ChatLambdaEnvEncryptionKey","Arn"]},"DeadLetterConfig":{"TargetArn":{"Fn::GetAtt":["ChatLambdaDLQ","Arn"]}},"Environment":{"Variables":{"AGENT_RUNTIME_ARN":{"Ref":"AgentRuntimeArn"}}},"Code":{"ZipFile":"import json\nimport boto3\nimport os\n\ndef handler(event, context):\n    try:\n        body = json.loads(event.get('body', '{}'))\n        prompt = body.get('prompt', '')\n        session_id = body.get('sessionId', f\"session-{context.aws_request_id}\")\n        \n        if not prompt:\n            return {\n                'statusCode': 400,\n                'headers': cors_headers(),\n                'body': json.dumps({'error': 'prompt required'})\n            }\n        \n        # Invoke AgentCore\n        client = boto3.client('bedrock-agentcore')\n        agent_arn = os.environ['AGENT_RUNTIME_ARN']\n        \n        response = client.invoke_agent_runtime(\n            agentRuntimeArn=agent_arn,\n            payload=json.dumps({\n                'prompt': prompt,\n                'sessionId': session_id\n            }).encode('utf-8')\n        )\n        \n        # Read response\n        response_body = response['response'].read().decode('utf-8')\n        result = json.loads(response_body)\n        \n        return {\n            'statusCode': 200,\n            'headers': cors_headers(),\n            'body': json.dumps({\n                'result': result.get('result', ''),\n                'sessionId': session_id\n            })\n        }\n    except Exception as e:\n        print(f\"Error: {str(e)}\")\n        return {\n            'statusCode': 500,\n            'headers': cors_headers(),\n            'body': json.dumps({'error': str(e)})\n        }\n\ndef cors_headers():\n    return {\n        'Content-Type': 'application/json',\n        'Access-Control-Allow-Origin': '*',\n        'Access-Control-Allow-Headers': 'Content-Type',\n        'Access-Control-Allow-Methods': 'POST,OPTIONS'\n    }\n"}}}}}}},{"ruleId":"AwsSolutions-APIG4","kind":"informational","level":"none","message":{"text":"The API does not implement authorization.\n\nException Reason: N/A"},"analysisTarget":{"uri":"deployment/chat-endpoint.yaml"},"locations":[{"id":1,"physicalLocation":{"artifactLocation":{"uri":"deployment/chat-endpoint.yaml"},"region":{"startLine":190,"startColumn":2,"endLine":190,"endColumn":12,"snippet":{"text":"Resources:\n  ChatMethod:\n    Properties:\n      AuthorizationType: COGNITO_USER_POOLS\n      AuthorizerId:\n        Ref: ChatCognitoAuthorizer\n      HttpMethod: POST\n     