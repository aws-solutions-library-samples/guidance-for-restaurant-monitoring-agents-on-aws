  "AuthenticatedRole": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Federated": "cognito-identity.amazonaws.com"
       },
       "Action": "sts:AssumeRoleWithWebIdentity",
       "Condition": {
        "StringEquals": {
         "cognito-identity.amazonaws.com:aud": {
          "Ref": "IdentityPool"
         }
        },
        "ForAnyValue:StringLike": {
         "cognito-identity.amazonaws.com:amr": "authenticated"
        }
       }
      }
     ]
    },
    "Policies": [
     {
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "cognito-sync:ListRecords",
          "cognito-sync:GetRecords",
          "cognito-identity:GetCredentialsForIdentity",
          "cognito-identity:GetId"
         ],
         "Resource": [
          {
           "Fn::Sub": "arn:aws:cognito-sync:${AWS::Region}:${AWS::AccountId}:identitypool/${IdentityPool}/*"
          },
          {
           "Fn::Sub": "arn:aws:cognito-identity:${AWS::Region}:${AWS::AccountId}:identitypool/${IdentityPool}"
          }
         ],
         "Condition": {
          "StringEquals": {
           "aws:RequestedRegion": {
            "Ref": "AWS::Region"
           }
          }
         }
        },
        {
         "Effect": "Allow",
         "Action": [
          "bedrock:InvokeModel",
          "bedrock:InvokeModelWithResponseStream",
          "bedrock:InvokeModelWithBidirectionalStream"
         ],
         "Resource": [
          {
           "Fn::Sub": "arn:aws:bedrock:${AWS::Region}::foundation-model/amazon.nova-2-sonic-v1:0"
          },
          {
           "Fn::Sub": "arn:aws:bedrock:${AWS::Region}::foundation-model/amazon.nova-sonic-v1:0"
          }
         ]
        },
        {
         "Effect": "Allow",
         "Action": [
          "bedrock-agentcore:InvokeAgentRuntime",
          "bedrock-agentcore:InvokeAgentRuntimeWithWebSocketStream"
         ],
         "Resource": "*"
        }
       ]
      },
      "PolicyName": "CognitoAuthorizedPolicy"
     }
    ],
    "RoleName": {
     "Fn::Sub": "${ProjectName}-authenticated-role-${Environment}"
    }
   }
  },
  "IdentityPoolRoleAttachment": {
