_headers(),\n            'body': json.dumps({'error': str(e)})\n        }\n\ndef cors_headers():\n    return {\n        'Content-Type': 'application/json',\n        'Access-Control-Allow-Origin': '*',\n        'Access-Control-Allow-Headers': 'Content-Type',\n        'Access-Control-Allow-Methods': 'POST,OPTIONS'\n    }\n"},"deadLetterConfig":{"targetArn":{"Fn::GetAtt":"ChatLambdaDLQ.Arn"}},"environment":{"variables":{"AGENT_RUNTIME_ARN":{"Ref":"AgentRuntimeArn"}}},"functionName":"RestaurantAgent-Chat","handler":"index.handler","kmsKeyArn":{"Fn::GetAtt":"ChatLambdaEnvEncryptionKey.Arn"},"memorySize":512,"reservedConcurrentExecutions":10,"role":{"Fn::GetAtt":"ChatLambdaRole.Arn"},"runtime":"python3.13","timeout":300}}},"ChatCognitoAuthorizer":{"id":"ChatCognitoAuthorizer","path":"ASHCDKNagScanner/deployment--chat-endpoint.yaml/ChatCognitoAuthorizer","constructInfo":{"fqn":"aws-cdk-lib.aws_apigateway.CfnAuthorizer","version":"2.242.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::ApiGateway::Authorizer","aws:cdk:cloudformation:props":{"identitySource":"method.request.header.Authorization","name":"ChatCognitoAuthorizer","providerArns":[{"Ref":"UserPoolArn"}],"restApiId":{"Ref":"RestApiId"},"type":"COGNITO_USER_POOLS"}}},"ChatResource":{"id":"ChatResource","path":"ASHCDKNagScanner/deployment--chat-endpoint.yaml/ChatResource","constructInfo":{"fqn":"aws-cdk-lib.aws_apigateway.CfnResource","version":"2.242.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::ApiGateway::Resource","aws:cdk:cloudformation:props":{"parentId":{"Ref":"RestApiRootResourceId"},"pathPart":"chat","restApiId":{"Ref":"RestApiId"}}}},"ChatMethod":{"id":"ChatMethod","path":"ASHCDKNagScanner/deployment--chat-endpoint.yaml/ChatMethod","constructInfo":{"fqn":"aws-cdk-lib.aws_apigateway.CfnMethod","version":"2.242.0"},"attributes":{"aws:cdk:cloudformation:type":"AWS::ApiGateway::Method","aws:cdk:cloudformation:props":{"authorizationType":"COGNITO_USER_POOLS","authorizerId":{"Ref":"ChatCognitoAuthoriz