#!/bin/bash
# =============================================================================
# Deployment Configuration
# =============================================================================
# EDIT THIS FILE BEFORE RUNNING ANY DEPLOYMENT SCRIPT.
#
# These are the only values you should need to change to deploy the guidance
# into your own AWS account. All deployment scripts source this file, and the
# agent + data loaders read the same values from their environment.
#
# Nothing here is account-specific by default (no account IDs, no generated
# Cognito/API IDs) so it is safe to commit. Resource identifiers that only
# exist AFTER deployment (Cognito Pool IDs, API Gateway URL, etc.) are written
# into frontend/config.js automatically by deploy-all.sh.
# =============================================================================

# --- AWS target -------------------------------------------------------------
# Region must support Amazon Bedrock AgentCore, Nova Lite, and Nova Sonic.
export AWS_REGION="${AWS_REGION:-us-east-1}"

# --- Stack / resource naming ------------------------------------------------
# ProjectName + Environment control CloudFormation stack resource names and
# DynamoDB table names. Change these to run multiple isolated instances.
export PROJECT_NAME="${PROJECT_NAME:-restaurant-kitchen-assistant}"
export ENVIRONMENT="${ENVIRONMENT:-production}"

# Logical name of the AgentCore runtime.
export AGENT_NAME="${AGENT_NAME:-restaurant_agent}"

# --- DynamoDB table names ---------------------------------------------------
# Defaults match the names created by restaurant-monitoring-base-template.yaml.
# Only override these if you renamed tables in the CloudFormation template.
export RESTAURANTS_TABLE="${RESTAURANTS_TABLE:-${PROJECT_NAME}-restaurants-${ENVIRONMENT}}"
export EQUIPMENT_TABLE="${EQUIPMENT_TABLE:-${PROJECT_NAME}-equipment-readings-${ENVIRONMENT}}"
export INVENTORY_TABLE="${INVENTORY_TABLE:-${PROJECT_NAME}-inventory-items-${ENVIRONMENT}}"
export STAFFING_TABLE="${STAFFING_TABLE:-${PROJECT_NAME}-staffing-requirements-${ENVIRONMENT}}"
export TICKETS_TABLE="${TICKETS_TABLE:-${PROJECT_NAME}-tickets-${ENVIRONMENT}}"

# --- Bedrock model IDs ------------------------------------------------------
# Text chat model (cross-region inference profile) and voice model.
# Update when migrating to newer models or non-US regions.
export TEXT_MODEL_ID="${TEXT_MODEL_ID:-us.amazon.nova-lite-v1:0}"
export VOICE_MODEL_ID="${VOICE_MODEL_ID:-amazon.nova-2-sonic-v1:0}"

# --- Demo user --------------------------------------------------------------
# A Cognito user created for first login. CHANGE THE PASSWORD before deploying
# and delete this user (or disable it) for any non-demo use.
export DEMO_USER_EMAIL="${DEMO_USER_EMAIL:-demo@example.com}"
export DEMO_USER_PASSWORD="${DEMO_USER_PASSWORD:-CHANGE_ME_BEFORE_DEPLOY}"
