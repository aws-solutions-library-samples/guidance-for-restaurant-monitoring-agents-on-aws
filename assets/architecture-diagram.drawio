        <mxCell id="step1" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;1&lt;/b&gt; Customer invokes the web application deployed on the edge in &lt;b&gt;Amazon CloudFront&lt;/b&gt; with &lt;b&gt;AWS WAF&lt;/b&gt; protection." vertex="1">
