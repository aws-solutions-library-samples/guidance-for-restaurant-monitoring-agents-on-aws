        <mxCell id="step2" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;2&lt;/b&gt; &lt;b&gt;Amazon Cognito&lt;/b&gt; enables authentication (MFA) and authorization for secure system access. Self-registration is disabled." vertex="1">
