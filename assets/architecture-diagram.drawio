        </mxCell>
        <mxCell id="step3" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;3&lt;/b&gt; Customer requests to &lt;b&gt;Amazon CloudFront&lt;/b&gt; are supported using website content stored in &lt;b&gt;Amazon S3&lt;/b&gt;." vertex="1">
