        </mxCell>
        <mxCell id="step4" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;4&lt;/b&gt; Customer requests from the web are routed as REST APIs to &lt;b&gt;Amazon API Gateway&lt;/b&gt; with Cognito authorizer." vertex="1">
          <mxGeometry height="35" width="360" x="1190" y="220" as="geometry" />
        </mxCell>
        <mxCell id="step5" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;5&lt;/b&gt; &lt;b&gt;AWS Lambda&lt;/b&gt; processes the &lt;b&gt;Amazon API Gateway&lt;/b&gt; requests by fetching and handling data from &lt;b&gt;Amazon DynamoDB&lt;/b&gt;." vertex="1">
          <mxGeometry height="35" width="360" x="1190" y="260" as="geometry" />
        </mxCell>
        <mxCell id="step6" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;6&lt;/b&gt; &lt;b&gt;Amazon DynamoDB&lt;/b&gt; (KMS CMK encrypted) functions as the central NoSQL database managing kitchen appliance and ticket information." vertex="1">
          <mxGeometry height="35" width="360" x="1190" y="300" as="geometry" />
        </mxCell>
        <mxCell id="step7" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;7&lt;/b&gt; Simulator feeds appliance data to &lt;b&gt;Amazon DynamoDB&lt;/b&gt; and triggers &lt;b&gt;Strands Agents&lt;/b&gt; for anomaly detection and ticket management." vertex="1">
          <mxGeometry height="35" width="360" x="1190" y="340" as="geometry" />
        </mxCell>
        <mxCell id="step8" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;8&lt;/b&gt; Gen AI Chat (text + voice) responds to user queries accessible via &lt;b&gt;Amazon API Gateway&lt;/b&gt;." vertex="1">
          <mxGeometry height="35" width="360" x="1190" y="380" as="geometry" />
        </mxCell>
        <mxCell id="step9" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;9&lt;/b&gt; &lt;b&gt;Amazon API Gateway&lt;/b&gt; and &lt;b&gt;AWS Lambda&lt;/b&gt; support requests via &lt;b&gt;Strands Agents&lt;/b&gt; and &lt;b&gt;Amazon Bedrock&lt;/b&gt; (Nova Lite + Nova Sonic)." vertex="1">
          <mxGeometry height="35" width="360" x="1190" y="420" as="geometry" />
        </mxCell>
        <mxCell id="step10" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;10&lt;/b&gt; &lt;b&gt;AWS IAM&lt;/b&gt; and &lt;b&gt;AWS KMS&lt;/b&gt; enable secure access and encryption (CMK) across all AWS services." vertex="1">
          <mxGeometry height="35" width="360" x="1190" y="460" as="geometry" />
        </mxCell>
        <mxCell id="step11" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;11&lt;/b&gt; &lt;b&gt;Amazon CloudWatch&lt;/b&gt; and &lt;b&gt;AWS CloudTrail&lt;/b&gt; provide system monitoring and audit logging capabilities." vertex="1">
          <mxGeometry height="35" width="360" x="1190" y="500" as="geometry" />
        </mxCell>
        <mxCell id="step12" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;12&lt;/b&gt; &lt;b&gt;Bedrock Knowledge Base&lt;/b&gt; with &lt;b&gt;OpenSearch Serverless&lt;/b&gt; provides RAG-based equipment manual search for maintenance, warranty, and troubleshooting." vertex="1">
          <mxGeometry height="45" width="360" x="1190" y="540" as="geometry" />
        </mxCell>
        <mxCell id="step13" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;spacingLeft=5;" value="&lt;b&gt;13&lt;/b&gt; &lt;b&gt;AgentCore Memory&lt;/b&gt; (STM + LTM) retains conversation context across sessions for personalized operator interactions." vertex="1">
          <mxGeometry height="45" width="360" x="1190" y="590" as="geometry" />
        </mxCell>
